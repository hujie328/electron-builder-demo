{
  "name": "electron_app",
  "version": "1.0.11",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-e": "electron-builder",
    "dev-e": "electron ."
  },
  "homepage": "",
  "author": {
    "name": "hujie",
    "email":"hujie_0328@163.com"
  },
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.1.7",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.2.1",
    "koa": "^2.15.3",
    "koa-static": "^5.0.0"
  },
  "devDependencies": {
    "electron": "31.3.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.example.app",
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://www.gzzgq.cn/cfeh5/desktop/"
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "linux": {
      "target": "deb",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
